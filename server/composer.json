{
    "name": "letsgetfit/server",
    "description": "LetsGetFit server code (deployed outside the web root)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "anthropic-ai/sdk": "^1.7",
        "guzzlehttp/guzzle": "^7.9",
        "phpmailer/phpmailer": "^7.2"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform-check": true,
        "allow-plugins": {
            "php-http/discovery": false
        },
        "autoloader-suffix": "LetsGetFit"
    }
}
