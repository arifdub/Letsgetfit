# LetsGetFit deployment settings — EXAMPLE ONLY.
#
# On the cPanel server, copy this file to ~/.config/letsgetfit/deploy.env and edit it:
#   mkdir -p ~/.config/letsgetfit && chmod 700 ~/.config/letsgetfit
#   cp ~/repositories/letsgetfit/config/deploy.env.example ~/.config/letsgetfit/deploy.env
#   chmod 600 ~/.config/letsgetfit/deploy.env
#
# The file is read as plain KEY=value lines; it is never executed.

# Absolute path of the letsgetfit.site document root, exactly as cPanel > Domains shows it.
# Do not assume public_html. Example for an addon domain:
DEPLOYPATH=/home/CPANELUSER/letsgetfit.site

# Optional: where to keep backups of overwritten files (must be outside the document root).
# BACKUP_DIR=/home/CPANELUSER/letsgetfit-backups

# Optional: how many backup archives to keep.
# KEEP_BACKUPS=5
